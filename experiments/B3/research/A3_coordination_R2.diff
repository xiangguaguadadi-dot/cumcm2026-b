+        The predicted gain only schedules measurements; it is never retained as
+        evidence. Actual returned bearings alone update the feasible polygons.
+        """
+        self._sharing = True
+        try:
+            p = self.position
+            for ch in range(1, 21):
+                if ch == exclude or ch in self.cleared or not self.observations[ch]:
+                    continue
+                if min(dist(p, old) for old, deg in self.observations[ch]) < 60:
+                    continue
+                center, radius = enclosing_circle(self.polygons[ch])
+                if radius <= 20 or dist(center, p) > 1500 + radius:
+                    continue
+                bearing = math.degrees(math.atan2(center[1]-p[1], center[0]-p[0]))
+                predicted = add_bearing(self.polygons[ch], p, bearing)
+                if not predicted:
+                    continue
+                _, next_radius = enclosing_circle(predicted)
+                if radius - next_radius < self.config.get('sharing_gain_m', 30.0):
+                    continue
+                self.measure(p, ch)
+        finally:
+            self._sharing = False
