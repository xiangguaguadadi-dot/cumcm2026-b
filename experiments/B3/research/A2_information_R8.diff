+    def nearest_certified_clear(self,poly,center,radius):
+        """Project current position onto all-vertex 20 m disk intersection.
+
+        A polygon is inside a 20 m clear disk exactly when every vertex is.
+        The nearest feasible point lies at the current position, on a single
+        disk's radial projection, or at an intersection of two circle edges.
+        This finite enumeration is specific to the 2-D optical action region.
+        """
+        if radius>20:
+            return center
+        rr=20.0-1e-7
+        def feasible(q):
+            return all(dist(q,v)<=rr+1e-9 for v in poly)
+        if feasible(self.position):
+            return self.position
+        # The original disk-based standoff is a certified numerical fallback.
+        dd=dist(self.position,center);margin=max(0,20-radius-1e-6)
+        fallback=center if dd==0 else (center[0]+min(1.,margin/dd)*(self.position[0]-center[0]),
+                                       center[1]+min(1.,margin/dd)*(self.position[1]-center[1]))
+        if len(poly)>64:
+            # Keep the existing certificate at high geometric complexity; an
+            # optional exact projection must not exhaust the runtime budget.
+            return fallback
+        candidates=[fallback]
+        for v in poly:
+            d=dist(self.position,v)
+            if d>1e-12:
+                q=(v[0]+rr*(self.position[0]-v[0])/d,v[1]+rr*(self.position[1]-v[1])/d)
+                if feasible(q):
+                    candidates.append(q)
+        for i,a in enumerate(poly):
+            for b in poly[i+1:]:
+                d=dist(a,b)
+                if d<1e-10 or d>2*rr:
+                    continue
+                midpoint=((a[0]+b[0])/2,(a[1]+b[1])/2)
+                height=math.sqrt(max(0.,rr*rr-d*d/4))
+                perpendicular=(-(b[1]-a[1])/d,(b[0]-a[0])/d)
+                for sign in (-1,1):
+                    q=(midpoint[0]+sign*height*perpendicular[0],midpoint[1]+sign*height*perpendicular[1])
+                    if feasible(q):
+                        candidates.append(q)
+        q=min(candidates,key=lambda v:(dist(self.position,v),v))
+        if max(dist(q,v) for v in poly)>20+1e-8:
+            raise RuntimeError('Optical action projection failed its containment check')
+        return q
